# Optional: Google OAuth Web client ID for the Google Fit step import (web build; see README)
VITE_GOOGLE_FIT_CLIENT_ID=

# --- Server (npm run server) ---
# Free AI food logging + cloud assistant (see README "Free AI setup")
GEMINI_API_KEY=
# Free USDA FoodData Central key: real lab values for standard foods
USDA_API_KEY=
# Optional
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.8-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite
# OA_AI_PROVIDER=gemini            # or "claude" with ANTHROPIC_API_KEY
# OA_CORS_ORIGIN=https://localhost # the Android app's origin, if it syncs with this server
