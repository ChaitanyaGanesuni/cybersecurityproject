# Gita API — copy to .env (never commit real keys). Keys live ONLY on the server (spec §24).
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=*

# Google Gemini (free tier). Get a key at https://aistudio.google.com/app/apikey
# Leave unset to run with the deterministic mock provider (no network).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Optional FastAPI inference service (embeddings + Indic/Kokoro TTS)
INFERENCE_URL=
